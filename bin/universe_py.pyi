
from pathlib import Path
from typing import Tuple

import numpy as np
import numpy.typing as npt


class Universe:
    def __init__(self) -> None: ...

    # Simulation
    def engine_step(self) -> None: ...
    def engine_reset(self) -> None: ...
    def calculate_cycle(self, frames: int) -> None: ...
    def render(self) -> None: ...

    # Configuration
    def set_dt(self, dt: float) -> None: ...
    def set_theta(self, theta: float) -> None: ...
    def set_elasticity(self, elasticity: float) -> None: ...

    def switch_render(self, flag: bool) -> None: ...
    def switch_calculate(self, flag: bool) -> None: ...

    # Particles
    def spawn_cluster(
        self,
        b_count: int,
        b_mass: float,
        b_radius: float,
        b_spawn_r: float,
        b_omega: float,
        dm_count: int,
        dm_mass: float,
        dm_radius: float,
        dm_spawn_r: float,
        dm_omega: float,
    ) -> None: ...

    def get_particle_count(self) -> Tuple[int, int]:
        """Returns (baryon_count, dark_matter_count)."""
        ...

    # State
    def get_time(self) -> float: ...

    # NumPy arrays
    def get_pos_x(self) -> npt.NDArray[np.float32]: ...
    def get_pos_y(self) -> npt.NDArray[np.float32]: ...
    def get_pos_z(self) -> npt.NDArray[np.float32]: ...
    def get_dark(self) -> npt.NDArray[np.uint8]: ...

    def window_should_close(self) -> bool: ...

    # Save / Load
    def save_cluster(self) -> None: ...
    def load_cluster(self, save: str | Path = ...) -> None: ...
