from pathlib import Path
from typing import Tuple

import numpy as np
import numpy.typing as npt


class Universe:
    def __init__(self) -> None: ...

    # === Simulation ===
    def engine_step(self) -> None: ...
    def clear_all(self) -> None: ...
    def delete_dm(self) -> None: ...
    def render(self) -> None: ...

    # === Configuration ===
    def set_dt(self, dt: float) -> None: ...
    def switch_render(self, flag: bool) -> None: ...
    def switch_calculate(self, flag: bool) -> None: ...

    # === SPH configs ===
    def set_stiffness(self, stiff: float) -> None: ...
    def set_h(self, h: float) -> None: ...
    def set_rest_density(self, rest_dens: float) -> None: ...
    def set_gamma(self, g: float) -> None: ...
    def set_alpha(self, a: float) -> None: ...
    def set_cs(self, cs: float) -> None: ...
    def update_cell_size(self) -> None: ...

    # === Particles ===
    def spawn_cluster(
        self,
        b_count: int,
        b_mass: float,
        b_spawn_r: float,
        b_omega: float,
        dm_count: int,
        dm_mass: float,
        dm_spawn_r: float,
        dm_omega: float,
    ) -> None: ...

    def get_particle_count(self) -> Tuple[int, int]:
        """Returns (baryon_count, dark_matter_count)"""
        ...

    # === State ===
    def get_time(self) -> float: ...
    def window_should_close(self) -> bool: ...

    # === NumPy getters (zero-copy) ===
    def get_posX(self) -> npt.NDArray[np.float32]: ...
    def get_posY(self) -> npt.NDArray[np.float32]: ...
    def get_posZ(self) -> npt.NDArray[np.float32]: ...
    def get_velX(self) -> npt.NDArray[np.float32]: ...
    def get_velY(self) -> npt.NDArray[np.float32]: ...
    def get_velZ(self) -> npt.NDArray[np.float32]: ...
    def get_mass(self) -> npt.NDArray[np.float32]: ...
    def get_dark(self) -> npt.NDArray[np.uint8]: ...

    # === Save / Load ===
    def save_cluster(self, save: str | Path = ...) -> None: ...

    def load_cluster(
        self,
        save: str | Path = ...,
        normal: bool = ...,
        dpx: float = ...,
        dpy: float = ...,
        dpz: float = ...,
        dvx: float = ...,
        dvy: float = ...,
        dvz: float = ...,
        rot: npt.ArrayLike | None = ...,
    ) -> None: ...

    # === Analysis ===
    def density_profile(
        self,
        bin_r: npt.NDArray[np.float32],
        b_density: npt.NDArray[np.float32],
        dm_density: npt.NDArray[np.float32],
    ) -> None: ...

    def rotation_curve(
        self,
        r_b: npt.NDArray[np.float32],
        b_tang_vel: npt.NDArray[np.float32],
        r_dm: npt.NDArray[np.float32],
        dm_tang_vel: npt.NDArray[np.float32],
    ) -> None: ...